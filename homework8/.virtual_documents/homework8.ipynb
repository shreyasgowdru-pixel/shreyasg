import numpy as np
import matplotlib.pyplot as plt

def make_sine_wave(x, A, w):
    return A * np.sin(w * x)

x = np.linspace(0, 2 * np.pi, 1000)

amplitude = np.array([0.5, 1, 1.5, 2, 2.5])
frequency = np.array([1, 2, 3, 4, 5])


linestyles = ['-', '--', '-.', ':', (0, (3, 1, 1, 1))]

fig, axes = plt.subplots(1, 3, figsize=(25, 5))

for A, w, style in zip(amplitude, frequency, linestyles):
    y1 = make_sine_wave(x, A, 1)
    axes[0].plot(x, y1, linestyle=style, label=f"A={A}, ω=1")
    
    y2 = make_sine_wave(x, 1, w)
    axes[1].plot(x, y2, linestyle=style, label=f"A=1, ω={w}")
    
    y3 = make_sine_wave(x, A, w)
    axes[2].plot(x, y3, linestyle=style, label=f"A={A}, ω={w}")

titles = ["Varying Amplitude (ω = 1)", "Varying Frequency (A = 1)", "Varying Both Amplitude & Frequency"]

for i in range(3):
    axes[i].set_title(titles[i], fontsize=16)
    axes[i].set_xlabel("x (radians)", fontsize=14)
    axes[i].set_ylabel("y", fontsize=14)
    axes[i].legend()

plt.show()


